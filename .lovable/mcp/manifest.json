{
  "version": 1,
  "sdk_version": "0.26.1",
  "path": "/mcp",
  "auth": {
    "type": "oauth",
    "issuer": "https://ptfgvlvuzbessphmdunh.supabase.co/auth/v1",
    "accepted_audiences": [
      "authenticated"
    ]
  },
  "mcp": {
    "server": {
      "name": "brand-spark-suite",
      "version": "0.1.0",
      "title": "Brand Spark Suite"
    },
    "tools": [
      {
        "name": "get_brand_profile",
        "title": "Get brand profile",
        "description": "Read the signed-in user's brand profile: business name, website, description, products and services, ICP, propositions, tone, keywords and social handles. This is the source material used to generate content.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {}
        },
        "outputSchema": null
      },
      {
        "name": "update_brand_profile",
        "title": "Update brand profile",
        "description": "Update one or more fields on the signed-in user's brand profile. Only the fields you pass are changed; everything else is left as-is. Creates the profile if it does not exist yet.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "business_name": {
              "description": "Business or brand name.",
              "type": "string",
              "maxLength": 200
            },
            "website": {
              "description": "Business website URL.",
              "type": "string",
              "maxLength": 500
            },
            "description": {
              "description": "What the business does.",
              "type": "string",
              "maxLength": 4000
            },
            "products_services": {
              "description": "Products and services offered.",
              "type": "string",
              "maxLength": 4000
            },
            "icp": {
              "description": "Ideal customer profile / target audience.",
              "type": "string",
              "maxLength": 4000
            },
            "propositions": {
              "description": "Value propositions and differentiators.",
              "type": "string",
              "maxLength": 4000
            },
            "tone": {
              "description": "Brand voice and tone of the content.",
              "type": "string",
              "maxLength": 1000
            },
            "keywords": {
              "description": "Comma-separated SEO or topic keywords.",
              "type": "string",
              "maxLength": 2000
            },
            "google_drive_folder": {
              "description": "Google Drive folder link for brand assets.",
              "type": "string",
              "maxLength": 500
            }
          }
        },
        "outputSchema": null
      },
      {
        "name": "list_content_items",
        "title": "List scheduled content",
        "description": "List the signed-in user's scheduled content for a date range. Returns one row per piece (blog, infographic or video) with its date, time, type, title, platforms, status and whether it is enabled. Use it to review what is on the content calendar.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "start_date": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
              "description": "First scheduled date to include, YYYY-MM-DD."
            },
            "end_date": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
              "description": "Last scheduled date to include, YYYY-MM-DD."
            },
            "type": {
              "description": "Only return this content type.",
              "type": "string",
              "enum": [
                "blog",
                "infographic",
                "video"
              ]
            },
            "enabled_only": {
              "description": "When true, only return items that are enabled.",
              "type": "boolean"
            },
            "limit": {
              "description": "Maximum rows to return (default 100).",
              "type": "integer",
              "minimum": 1,
              "maximum": 200
            }
          },
          "required": [
            "start_date",
            "end_date"
          ]
        },
        "outputSchema": null
      },
      {
        "name": "get_content_item",
        "title": "Get content item",
        "description": "Read one scheduled content item in full for the signed-in user, including the blog body, caption, hashtags, image prompt, video script, platforms and performance metrics.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
              "description": "The content item id, as returned by list_content_items."
            }
          },
          "required": [
            "id"
          ]
        },
        "outputSchema": null
      },
      {
        "name": "set_content_enabled",
        "title": "Enable or disable content",
        "description": "Turn scheduled content on or off for the signed-in user. Pass an item id to change a single piece, or a date to change every piece scheduled that day. Disabled content stays on the calendar but is not posted.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean",
              "description": "True to enable the content, false to disable it."
            },
            "id": {
              "description": "A single content item id to change.",
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            },
            "scheduled_date": {
              "description": "Change every item scheduled on this date, YYYY-MM-DD.",
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            }
          },
          "required": [
            "enabled"
          ]
        },
        "outputSchema": null
      }
    ]
  }
}
