# Copy to .env for local development. Never commit real values.
# In production/staging add these in your host's encrypted environment settings, then redeploy.

# ── Owner account ─────────────────────────────────────────────
# Email of the owner/root account (gets the Scale plan + Admin Portal bootstrap).
# Set BOTH to the same value: ROOT_EMAIL for the server, VITE_ROOT_EMAIL for the browser build.
# If left empty, no account is root by email (use the Admin Portal / user_roles instead).
ROOT_EMAIL=
VITE_ROOT_EMAIL=

# ── Supabase ──────────────────────────────────────────────────
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=
# VITE_SUPABASE_ANON_KEY=   (legacy name, only if still used in your build)

# ── App ───────────────────────────────────────────────────────
PUBLIC_APP_URL=
# VITE_APP_ENV=
# VITE_LANDING_URL=
# Secret that protects the cron endpoints (/api/public/hooks/*).
CRON_SECRET=
# Set automatically by Vercel. Auto-generation only runs when this is "production".
# VERCEL_ENV=

# ── AI text ───────────────────────────────────────────────────
GROQ_API_KEY=
# Optional: weekly strategy call
# STRATEGY_MODEL=openai/gpt-oss-120b
# STRATEGY_REASONING=medium
# Legacy Gemini generator (src/lib/content/generateContent.ts)
LOVIZA_GEMINI_API_KEY=

# ── AI images / video ─────────────────────────────────────────
# "pollinations" (free, default) or "fal"
IMAGE_PROVIDER=pollinations
FAL_KEY=
# FAL_MODEL=
# FAL_VIDEO_MODEL=
# VIDEO_PROVIDER=
# VIDEO_GENERATION_ENABLED=false
SHOTSTACK_API_KEY=
# SHOTSTACK_ENV=
# SHOTSTACK_VOICE=
# POSTER_COMPOSER=on
# CAROUSEL_ENABLED=false

# ── Payments (Razorpay) ───────────────────────────────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_PLAN_STARTER=
RAZORPAY_PLAN_GROWTH=
RAZORPAY_PLAN_SCALE=

# ── Email ─────────────────────────────────────────────────────
RESEND_API_KEY=
EMAIL_FROM=

# ── Social publishing (server-only) ───────────────────────────
# Required to start and secure all OAuth connections.
OAUTH_STATE_SECRET=
# LinkedIn member publishing.
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# Change only when LinkedIn announces a newer supported REST version.
LINKEDIN_VERSION=202606


ROOT_EMAIL=shashank.bawane@gmail.com
VITE_ROOT_EMAIL=shashank.bawane@gmail.com


