# Server-only social publishing credentials. Do not commit real values.
# In production, add these in your hosting provider's encrypted environment
# settings, then redeploy.

# Required to start and secure all OAuth connections.
OAUTH_STATE_SECRET=

# Required for LinkedIn member publishing.
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# Optional: change only when LinkedIn announces a newer supported REST version.
LINKEDIN_VERSION=202606



# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"


